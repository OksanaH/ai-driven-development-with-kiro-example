{
  "name": "text-summary-extractor",
  "version": "0.1.0",
  "description": "Proof-of-concept CLI that summarizes a text document or a ZIP of images using Amazon Textract and Amazon Bedrock.",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "text-summary-extractor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-textract": "^3.700.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
